{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {
    "pyright": { "command": ["pyright-langserver", "--stdio"], "extensions": ["py"], "disabled": false },
    "ruff": { "command": ["ruff", "server"], "extensions": ["py"], "disabled": false },
    "texlab": { "command": ["texlab"], "extensions": ["tex", "bib", "sty", "cls"], "disabled": false },
    "yaml": { "command": ["yaml-language-server", "--stdio"], "extensions": ["yaml", "yml"], "disabled": false },
    "taplo": { "command": ["taplo", "lsp", "stdio"], "extensions": ["toml"], "disabled": false },
    "marksman": { "command": ["marksman"], "extensions": ["md"], "disabled": false },
    "bash": { "command": ["bash-language-server", "start"], "extensions": ["sh", "bash"], "disabled": false },
    "typescript": { "disabled": true },
    "gopls": { "disabled": true },
    "dockerfile": { "disabled": true }
  },
  "mcp": {
    "codebase_memory": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": true
    },
    "sequential_thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["uvx", "mcp-server-fetch"],
      "enabled": true
    },
    "academic_research": {
      "type": "local",
      "command": ["uvx", "academic-research-mcp"],
      "enabled": true
    },
    "zotero": {
      "type": "local",
      "command": ["uvx", "--from", "zotero-mcp-server", "zotero-mcp", "serve"],
      "enabled": true
    },
    "arxiv": {
      "type": "local",
      "command": ["uvx", "arxiv-mcp-server"],
      "enabled": true
    },
    "duckdb": {
      "type": "local",
      "command": ["uvx", "mcp-server-motherduck", "--read-write"],
      "enabled": true
    },
    "sympy": {
      "type": "local",
      "command": ["uvx", "mcp-sympy"],
      "enabled": true
    }
  },
  "permission": "allow"
}