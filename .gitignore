paper/experiments/agent-state/

# Raw experiment output directories
output/
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
experiments/*/outputs/

# Archive (large files)
archive/*.tar.gz
archive/*.zip

# Archived datasets and vendored payloads (large — never commit)
archive/data/
archive/hackathon/
archive/kaggle_payloads/

# Raw experiment outputs (reference only, kept on disk)
archive/**/*.pkl
archive/**/__pycache__/

# Archived build outputs (PDFs, bundles)
archive/**/*.pdf

# Archived superseded-paper planning and internal records (never re-track)
archive/paper01/planning/

# Superseded Paper 01 — derived/untracked artifacts (tracked manuscript sources stay tracked)
archive/paper01/**/*.png
archive/paper01/submission/
archive/paper01/templates/

